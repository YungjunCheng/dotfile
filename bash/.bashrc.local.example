# ~/.bashrc.local — template for machine-local config
# Usage: copy to ~/.bashrc.local (stow does not manage this file)
#        it is sourced automatically at the top of the bash package's .bashrc.
# Good for: local paths, private toolchains, mirror sources, secret env vars,
#           anything you do not want to make public.

# Examles (uncomment as needed)
# export PATH="$HOME/.local/bin:$PATH"
